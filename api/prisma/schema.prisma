generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShippingMethod {
  SUCURSAL
  DOMICILIO
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

enum ProductRequestStatus {
  PENDING
  FULFILLED
  DISMISSED
}

enum ProductSerialStatus {
  IN_STOCK
  SHIPPED
}

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  brands    Brand[]
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Brand {
  id         String    @id @default(uuid())
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  images      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems   OrderItem[]
  stockAlerts  StockAlert[]
  productRequests ProductRequest[]
  serials      ProductSerial[]

  @@index([categoryId])
  @@index([brandId])
}

model Order {
  id              String      @id @default(uuid())
  // Número simple para mostrarle al cliente y al admin (mail, panel,
  // formulario de devolución) — el id sigue siendo el UUID interno, este es
  // solo para que sea fácil de leer y dictar.
  orderNumber     Int         @unique @default(autoincrement())
  status          OrderStatus @default(PENDING)

  buyerName       String
  buyerEmail      String
  buyerPhone      String

  shippingStreet  String
  shippingNumber  String
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingMethod  ShippingMethod @default(DOMICILIO)
  shippingCost    Decimal     @db.Decimal(10, 2) @default(0)

  itemsTotal      Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)

  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  returnRequests  ReturnRequest[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(uuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

// Tarifa de envío fija por provincia, cargada y mantenida a mano por el
// admin (reemplaza la cotización automática de Andreani: el envío en sí
// se coordina manualmente una vez que la orden está pagada).
model ShippingRate {
  id             String   @id @default(uuid())
  province       String   @unique
  // Retiro en sucursal (Andreani u otro correo) vs. entrega a domicilio.
  costSucursal   Decimal  @db.Decimal(10, 2)
  costDomicilio  Decimal  @db.Decimal(10, 2)
  estimatedDays  Int      @default(7)
  updatedAt      DateTime @updatedAt
}

model Payment {
  id             String   @id @default(uuid())
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        String   @unique
  provider       String   @default("mercadopago")
  preferenceId   String?
  // Id del pago en Mercado Pago. Único (permite varios NULL) para poder usarlo
  // como clave de idempotencia al finalizar un pago aprobado: webhook y
  // resolve pueden llegar en paralelo o duplicados para el mismo pago.
  externalId     String?  @unique
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Shipment {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
  provider     String   @default("manual")
  trackingId   String?
  // pending -> preparing -> shipped -> delivered (a mano, desde el panel admin)
  status       String   @default("pending")
  note         String?
  serials      ProductSerial[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Número de serie de una unidad física de un producto. Se carga uno por
// unidad al ingresar stock nuevo, y queda vinculado al envío (Shipment) en el
// que esa unidad puntual salió, para tener trazabilidad de qué se mandó.
model ProductSerial {
  id           String              @id @default(uuid())
  product      Product             @relation(fields: [productId], references: [id])
  productId    String
  serialNumber String              @unique
  status       ProductSerialStatus @default(IN_STOCK)
  shipment     Shipment?           @relation(fields: [shipmentId], references: [id])
  shipmentId   String?
  createdAt    DateTime            @default(now())
  shippedAt    DateTime?

  @@index([productId])
  @@index([shipmentId])
}

// Alguien pide un producto que hoy no está en el catálogo. Queda pendiente
// hasta que el admin lo vincula con un Product recién creado (dispara el
// aviso) o lo descarta manualmente.
model ProductRequest {
  id            String                @id @default(uuid())
  name          String
  brand         String?
  category      String?
  notes         String?
  buyerEmail    String
  buyerPhone    String?
  status        ProductRequestStatus  @default(PENDING)
  linkedProduct Product?              @relation(fields: [linkedProductId], references: [id])
  linkedProductId String?
  createdAt     DateTime              @default(now())
  fulfilledAt   DateTime?

  @@index([linkedProductId])
}

// Alguien pide que le avisen cuando un producto puntual (que sí existe, pero
// está sin stock) vuelva a tener stock. Esto SÍ se resuelve solo: cuando el
// stock del producto pasa de 0 a >0, se notifica y se marca notified=true.
model StockAlert {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  buyerEmail String
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  notifiedAt DateTime?

  @@index([productId])
}

// Pedido de devolución de un cliente sobre una orden puntual. Las fotos son
// opcionales (no todos los compradores las suben), pero el front insiste en
// pedirlas porque agilizan mucho la revisión del admin.
model ReturnRequest {
  id         String              @id @default(uuid())
  order      Order               @relation(fields: [orderId], references: [id])
  orderId    String
  buyerEmail String
  reason     String
  images     String[]            @default([])
  status     ReturnRequestStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([orderId])
}