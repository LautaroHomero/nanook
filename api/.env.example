DATABASE_URL=postgresql://pedales:pedales@localhost:5432/pedales?schema=public
JWT_SECRET=dev-secret-change-me
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=admin123
PORT=3001

# Cuando tengas credenciales reales, poné MP_MOCK=false y ANDREANI_MOCK=false
# El SDK oficial de Mercado Pago usa MP_ACCESS_TOKEN en el backend.
MP_MOCK=true
MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_WEBHOOK_SECRET=REPLACE_WITH_YOUR_MERCADO_PAGO_WEBHOOK_SECRET
MP_SUCCESS_URL=http://localhost:3003/checkout/success
MP_FAILURE_URL=http://localhost:3003/checkout/failure
MP_PENDING_URL=http://localhost:3003/checkout/pending
MP_NOTIFICATION_URL=https://YOUR_PUBLIC_DOMAIN/api/payments/webhook
MP_CURRENCY_ID=ARS
ANDREANI_MOCK=true
ANDREANI_API_KEY=
ANDREANI_CLIENT_TOKEN=
