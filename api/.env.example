DATABASE_URL=postgresql://pedales:pedales@localhost:5432/pedales?schema=public
JWT_SECRET=dev-secret-change-me
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=admin123
PORT=3001

# Cuando tengas credenciales reales, poné MP_MOCK=false y ANDREANI_MOCK=false
# El SDK oficial de Mercado Pago usa MP_ACCESS_TOKEN en el backend.
MP_MOCK=true
MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_WEBHOOK_SECRET=REPLACE_WITH_YOUR_MERCADO_PAGO_WEBHOOK_SECRET
MP_SUCCESS_URL=http://localhost:3003/checkout/success
MP_FAILURE_URL=http://localhost:3003/checkout/failure
MP_PENDING_URL=http://localhost:3003/checkout/pending
MP_NOTIFICATION_URL=https://YOUR_PUBLIC_DOMAIN/api/payments/webhook
MP_CURRENCY_ID=ARS
# Recargo que Mercado Pago nos cobra de comisión, trasladado al comprador.
MP_SURCHARGE_PERCENT=4.3

# Datos de la cuenta BBVA que se le muestran al comprador que elige pagar por
# transferencia. La confirmación del pago es manual (ver panel admin /pedidos):
# no hay forma automática de saber que la transferencia se acreditó.
# Estos son solo el valor inicial: el admin puede editarlos en cualquier
# momento desde el panel (Compras → "Datos bancarios para transferencia"),
# sin redesplegar nada — ver BankTransferSettings en el schema de Prisma.
BANK_TRANSFER_BANK_NAME=BBVA
BANK_TRANSFER_CBU=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_HOLDER_NAME=
BANK_TRANSFER_HOLDER_CUIT=

ANDREANI_MOCK=true
ANDREANI_API_KEY=
ANDREANI_CLIENT_TOKEN=

# Opcional en local: sin estas tres, las fotos de producto se guardan en
# disco (./uploads). En producción son obligatorias, porque el disco del
# contenedor no persiste entre deploys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
